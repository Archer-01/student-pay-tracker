# The central (accounts) database; each teacher's data goes in a tenant-<id>.db beside it.
DATABASE_URL=sqlite:///./app.db

# Local http only: a Secure cookie is dropped over http, and sign-in silently fails.
# Never set this to false in production.
COOKIE_SECURE=false

# How long a sign-in lasts, in days, counted from login.
SESSION_TTL_DAYS=90

# The school owner's share of every payment, 0-100 (0 hides it).
SCHOOL_SHARE_PERCENT=25

# Language when a request names none (the app always sends one): en or fr.
DEFAULT_LOCALE=en

LOG_LEVEL=INFO

# CLI only: the teacher whose data commands work on (instead of --user).
# ARDOISE_USER=aymen
