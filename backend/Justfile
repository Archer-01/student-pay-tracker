# Every test, in parallel, without coverage: the everyday loop.
test:
    uv run pytest -n auto

# Only tests/unit: pure functions, no database.
test-unit:
    uv run pytest tests/unit

# Every test with coverage: all of app/ at 95 %, app/services at 100 % (what CI runs).
cov:
    uv run pytest -n auto --cov --cov-report=term
    uv run coverage report --include='app/services/*' --fail-under=100

lint:
    uv run ruff format --check .
    uv run ruff check .
    uv run mypy app

run:
    uv run fastapi dev app/main.py

# Run against a copy of production data in local-prod/ (gitignored, like every *.db here)
run-prod-copy:
    DATABASE_URL=sqlite:///./local-prod/central.db uv run fastapi dev app/main.py

migrate:
    uv run alembic upgrade head

backup:
    uv run ardoise db backup

docker-up:
    docker compose up --build
