test:
    uv run pytest

lint:
    uv run ruff check .
    uv run mypy app

run:
    uv run fastapi dev app/main.py

# Run against a copy of production data in local-prod/ (gitignored, like every *.db here)
run-prod-copy:
    DATABASE_URL=sqlite:///./local-prod/central.db uv run fastapi dev app/main.py

migrate:
    uv run alembic upgrade head

backup:
    uv run ardoise db backup

docker-up:
    docker compose up --build
